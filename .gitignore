# private working areas — raw dumps and undecided items never reach git
inbox/*
!inbox/README.md
review/*
!review/README.md
quarantine/
local/

# resource files live in the Google Drive mirror (docs/STORAGE.md); git keeps only text:
# sidecars (*.meta.yaml), course.yaml, generated READMEs, exam maps (*.md)
courses/**/*.*
!courses/**/*.yaml
!courses/**/*.md
general/**/*.*
!general/**/*.yaml
!general/**/*.md

